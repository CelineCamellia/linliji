# 公网部署前复制为 runtime.env，填写你自己的资料。
APP_MODE=production
PUBLIC_ORIGIN=https://your-domain.cn
OPERATOR_NAME=请填写运营者名称
SUPPORT_EMAIL=contact@your-domain.cn
REGISTRATION_MODE=open
# invite 模式时需填写至少 16 位随机邀请码
INVITE_CODE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为至少16位随机密码
DEFAULT_CITY=洛阳
SUPPORTED_CITIES=洛阳,北京,上海,广州,深圳,成都,杭州
# 仅微信小程序需要；两项同时留空即关闭微信登录。
WX_APPID=
WX_APP_SECRET=
